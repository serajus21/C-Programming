$ gcc -std=c23 -Wall -Wextra -pedantic -O0 -g -c ops.c -o og.o && objdump -d -S --no-show-raw-insn og.o | sed -n '/<times10>:/,/^$/p'
0000000000000000 <times10>:
// ops.c
// Three small functions, to watch the optimizer at work.
int times10(int x) {
   0:	push   %rbp
   1:	mov    %rsp,%rbp
   4:	mov    %edi,-0x4(%rbp)
    return x * 10;
   7:	mov    -0x4(%rbp),%edx
   a:	mov    %edx,%eax
   c:	shl    $0x2,%eax
   f:	add    %edx,%eax
  11:	add    %eax,%eax
}
  13:	pop    %rbp
  14:	ret

[exit 0]
