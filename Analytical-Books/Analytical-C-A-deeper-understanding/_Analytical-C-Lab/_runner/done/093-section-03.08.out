
$ cat noinclude.c glued.c indent.c
// noinclude.c
// hello.c without its first line.
int main(void) {
    printf("hello, world\n");
    return 0;
}
// glued.c
// Two spaces removed from hello.c.
#include <stdio.h>

intmain(void) {
    printf("hello, world\n");
    return0;
}
// indent.c
// The layout says one thing, the tokens another.
#include <stdio.h>

int check(int err) {
    if (err != 0)
        printf("first check failed\n");
        return 1;
    printf("all checks passed\n");
    return 0;
}

int main(void) {
    return check(0);
}
[exit 0]

