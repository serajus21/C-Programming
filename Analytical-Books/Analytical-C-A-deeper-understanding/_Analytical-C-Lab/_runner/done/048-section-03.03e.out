
$ cat -n semi.c
     1	// semi.c
     2	// hello.c with one semicolon missing.
     3	#include <stdio.h>
     4	
     5	int main(void) {
     6	    printf("hello, world\n")
     7	    return 0;
     8	}
[exit 0]

$ gcc -std=c23 -Wall -Wextra -pedantic semi.c -o semi
