
$ gcc -std=c23 -Wall -Wextra -pedantic hello.o -o hmove -Wl,-Ttext-segment=0x800000 && ./hmove && nm hmove | grep -w -E 'main|_start' && objdump -d hmove | sed -n '/<main>:/,/^$/p'
hello, world
0000000000801136 T main
0000000000801040 T _start
0000000000801136 <main>:
