  801137:	48 89 e5             	mov    %rsp,%rbp
  80113a:	bf b0 04 80 00       	mov    $0x8004b0,%edi
  80113f:	e8 ec fe ff ff       	call   801030 <puts@plt>
  801144:	b8 00 00 00 00       	mov    $0x0,%eax
  801149:	5d                   	pop    %rbp
  80114a:	c3                   	ret

[exit 0]

$ gcc -std=c23 -Wall -Wextra -pedantic hello.o -o hnosep -Wl,-z,noseparate-code && nm hnosep | grep -w main && readelf -l hnosep | grep -c LOAD
