
$ cat e1.c; gcc -std=c23 -Wall -Wextra -pedantic e1.c -o e1 && ./e1
#include <stdio.h>
#define GREETING "hello, " \
"world\n"
int main(void) { printf(GREETING); return 0; }
hello, world
[exit 0]

$ cat e1b.c; gcc -std=c23 -Wall -Wextra -pedantic e1b.c -o e1b
#include <stdio.h>
#define GREETING "hello, "
"world\n"
int main(void) { printf(GREETING); return 0; }
e1b.c:3:1: error: expected identifier or ‘(’ before string constant
    3 | "world\n"
      | ^~~~~~~~~
[exit 1]

$ cat e2.c; gcc -std=c23 -Wall -Wextra -pedantic -c e2.c -o e2.o && echo compiled
int x = 0x1E+1;
e2.c:1:9: error: invalid suffix ‘+1’ on integer constant
    1 | int x = 0x1E+1;
      |         ^~~~~~
[exit 1]

$ cat e2.c; gcc -std=c23 -Wall -Wextra -pedantic -c e2.c -o e2.o && echo compiled
int x = 0x1E + 1;
compiled
[exit 0]

$ cat e2.c; gcc -std=c23 -Wall -Wextra -pedantic -c e2.c -o e2.o && echo compiled
int x = 0x1F+1;
