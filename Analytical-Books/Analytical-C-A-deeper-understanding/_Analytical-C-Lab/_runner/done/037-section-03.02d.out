$ cat e2.c; gcc -std=c23 -Wall -Wextra -pedantic -c e2.c -o e2.o && echo compiled
int x = 1.5.2;
e2.c:1:9: error: too many decimal points in number
    1 | int x = 1.5.2;
      |         ^~~~~
