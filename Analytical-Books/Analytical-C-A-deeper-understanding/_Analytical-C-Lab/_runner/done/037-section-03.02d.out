$ cat e2.c; gcc -std=c23 -Wall -Wextra -pedantic -c e2.c -o e2.o && echo compiled
int x = 0b101;
compiled
[exit 0]

$ gcc -std=c23 -Wall -Wextra -pedantic -c greet.c && gcc -std=c23 -Wall -Wextra -pedantic -c greet_def.c && gcc greet.o greet_def.o -o greet && ./greet
hello from greet
[exit 0]

