$ cat sq.c; gcc -std=c23 -Wall -Wextra -pedantic sq.c -o sq && ./sq; gcc -std=c23 -E -P sq.c | tail -4
#include <stdio.h>
#define SQUARE(x) x * x
int main(void) {
    printf("%d\n", 100 / SQUARE(5));
    return 0;
}
100
int main(void) {
    printf("%d\n", 100 / 5 * 5);
    return 0;
}
