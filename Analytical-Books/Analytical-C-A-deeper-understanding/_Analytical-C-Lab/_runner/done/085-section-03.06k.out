$ cat /usr/lib/gcc/x86_64-redhat-linux/16/libatomic_asneeded.so /usr/lib/gcc/x86_64-redhat-linux/16/libatomic.so
/* GNU ld script
   Add DT_NEEDED entry for -latomic only if needed.  */
OUTPUT_FORMAT(elf64-x86-64)
INPUT ( AS_NEEDED ( -latomic ) )
INPUT ( /usr/lib64/libatomic.so.1.2.0 )
[exit 0]

$ ld -m elf_x86_64 -dynamic-linker /lib64/ld-linux-x86-64.so.2 -o hello_byhand4 /usr/lib64/crt1.o /usr/lib64/crti.o /usr/lib/gcc/x86_64-redhat-linux/16/crtbegin.o -L/usr/lib/gcc/x86_64-redhat-linux/16 -L/usr/lib64 hello.o -lgcc -lgcc_s_asneeded -latomic_asneeded -lc -lgcc -lgcc_s_asneeded /usr/lib/gcc/x86_64-redhat-linux/16/crtend.o /usr/lib64/crtn.o && ./hello_byhand4 && ls -l hello_byhand4 && cmp hello hello_byhand4 | head -1
hello, world
