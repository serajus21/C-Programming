$ printf 'int main(void){ return 0; }' > nonl.c; gcc -std=c23 -Wall -Wextra -pedantic nonl.c -o nonl; echo built
built
[exit 0]

$ printf 'int main(void){ return 0x1F+1; }\n' > f.c; gcc -std=c23 f.c -o f && ./f; echo $?
32
[exit 0]

$ gcc -std=c23 -E -P escape.c | tail -6
int main(void) {
    printf("hello, " "world" "\n");
    printf("%s\n", "\x41" "BC");
    printf("%zu\n", sizeof "\x41" "BC");
    return 0;
}
[exit 0]

