digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.4, dpi=200];
  node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", penwidth=1.4];
  edge [color="#5A6270", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10.5, fontcolor="#5A6270"];
  A [label="A", fillcolor="#E9ECF3", color="#1B2A4A", width=1.4];
  B [label="B", fillcolor="#E9ECF3", color="#1B2A4A", width=1.4];
  SUB [label="SUB\n0 = add, 1 = subtract", fillcolor="#FBF3E4", color="#8A5A00"];
  X [label="XOR each bit of B with SUB\n(SUB = 1 flips every bit)", fillcolor="#F1ECF8", color="#5B3E96"];
  ADD [label="8-bit ripple-carry adder", fillcolor="#EAF1FB", color="#1F5FAD", width=3.2];
  R [label="A + B   or   A + NOT B + 1  =  A − B", fillcolor="#E9ECF3", color="#1B2A4A"];
  B -> X; SUB -> X; X -> ADD; A -> ADD; SUB -> ADD [label=" carry in", color="#B42318", fontcolor="#B42318"]; ADD -> R;
  {rank=same; A; B; SUB}
}
