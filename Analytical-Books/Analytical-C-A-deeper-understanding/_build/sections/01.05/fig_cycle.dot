digraph G {
  graph [layout=neato, bgcolor="white", pad=0.2, dpi=200];
  node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", penwidth=1.5, width=2.6];
  edge [color="#5A6270", penwidth=1.5, arrowsize=0.85];
  F [pos="0,2.6!", label="1  FETCH\nIR ← memory[PC]", fillcolor="#EAF1FB", color="#1F5FAD"];
  I [pos="3.4,0!", label="2  ADVANCE\nPC ← PC + 1 instruction", fillcolor="#FBF3E4", color="#8A5A00"];
  D [pos="0,-2.6!", label="3  DECODE\nwhich operation?\nwhich operands?", fillcolor="#F1ECF8", color="#5B3E96"];
  E [pos="-3.4,0!", label="4  EXECUTE\nALU, memory, or\na new value for PC", fillcolor="#EAF5EA", color="#2E7D32"];
  F -> I -> D -> E -> F;
}
