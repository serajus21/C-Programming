digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.32, dpi=200];
  node [fontname="DejaVu Sans", fontsize=11, penwidth=1.4, fontcolor="#1B2A4A"];
  edge [color="#5A6270", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#5A6270"];
  q1 [shape=box, style="rounded", color="#5A6270", label="Does the standard impose\nany requirement here at all?"];
  q2 [shape=box, style="rounded", color="#5A6270", label="Does it fix a single outcome?"];
  q3 [shape=box, style="rounded", color="#5A6270", label="Does the outcome depend on local conventions\n(language, culture, nationality)?"];
  q4 [shape=box, style="rounded", color="#5A6270", label="Must the implementation\ndocument its choice?"];
  ub [shape=box, style="rounded,filled", fillcolor="#FBE9E7", color="#B23A2B", label=<<b>Undefined</b><br/>no requirements at all;<br/>a correct program must never do it>];
  df [shape=box, style="rounded,filled", fillcolor="#EAF5EA", color="#2E7D32", label=<<b>Defined</b><br/>the same on every<br/>conforming implementation>];
  ls [shape=box, style="rounded,filled", fillcolor="#F1ECF8", color="#5E3A8C", label=<<b>Locale-specific</b><br/>documented; changes with<br/>the locale selected>];
  id [shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#1F5FAD", label=<<b>Implementation-defined</b><br/>one documented choice;<br/>rely on it only for that implementation>];
  us [shape=box, style="rounded,filled", fillcolor="#FBF3E4", color="#8A5A00", label=<<b>Unspecified</b><br/>one of the permitted outcomes,<br/>not documented, may vary;<br/>a correct program accepts them all>];
  q1 -> ub [label="  no"];
  q1 -> q2 [label="  yes"];
  q2 -> df [label="  yes"];
  q2 -> q3 [label="  no: it permits\n  several"];
  q3 -> ls [label="  yes"];
  q3 -> q4 [label="  no"];
  q4 -> id [label="  yes"];
  q4 -> us [label="  no"];
  {rank=same; q1; ub}
  {rank=same; q2; df}
  {rank=same; q3; ls}
  {rank=same; id; us}
}
